<!-- Left Column: Quote -->
{{if $pass_val[0]==0}}
	<span class="section-subtitle">{{= &sub_title}}</span>
	<span class="slide-bg-color" data-color="{{= &left_bg_color}}" hidden></span>
	<div class="slider-quote-container">
		<blockquote class="testimonial-quote">&ldquo;{{= &quotes}}&rdquo;</blockquote>
		<div class="author-meta">
			<cite class="author-name">{{= &author}}</cite>
			<span class="author-location">{{= &location}}</span>
		</div>
	</div>
{{endif}}

<!-- Right Column: Background Image -->
{{if $pass_val[0]==1}}
	<div class="bg-slide" style="background-image: url('{{= &img == '' ? 'https://placehold.co/1920x630' : 'https://cdn.flicksell.com/'.&img}}');"></div>
{{endif}}

<!-- Product Card -->
{{if $pass_val[0]==2}}
<div class="card-slide">
	{{$product_item=system.product.get_product(&product)}}
	{{$variant=system.product.get_lowest_priced_variant(&product)}}
	{{$price=$variant["price"]}}
	{{$mrp=$variant["mrp"]}}
	<div class="card-image-container">
		<div class="product-shadow"></div>
		<img src="https://cdn.flicksell.com/{{= $product_item['main_img']}}" alt="{{= $product_item['name']}}"
		class="product-image primary-img">
		<img src="https://cdn.flicksell.com/{{= $product_item['images'][1]}}" alt="{{= $product_item['name']}} Hover"
		class="product-image hover-img">
		<button class="search-btn" aria-label="Search">
			<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
			stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="11" cy="11" r="7"></circle>
			<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
		</svg>
	</button>
	<button class="choose-btn">Choose Options</button>
</div>

<div class="card-details">
	<span class="product-category">{{-= &pro_cat}}</span>
	<h3 class="product-title">{{= $product_item['name']}}</h3>
	<span class="product-price">₹{{= $price}}</span>
</div>
</div>
{{endif}}