{{$menu = system.menu.get_menu(&menu)}}

<style>
	$_section {

		/* ================================================
		BAR 1 — ANNOUNCEMENT BAR (same style as before)
		================================================ */
		#announce-bar {
			background: #fdeef0;
			border-bottom: 1px solid rgba(0,0,0,0.04);
			font-size: 14px;
			font-family: "Poppins", sans-serif;
			position: relative;
			z-index: 1200;
		}
		.announce-inner {
			max-width: 1200px;
			margin: 0 auto;
			padding: 10px 20px;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 16px;
		}
		.ann-left a { color: #234; text-decoration: none; margin-right: 16px; font-weight: 400; }
		.ann-left a:hover { text-decoration: underline; }
		.ann-center { display: flex; align-items: center; gap: 8px; flex: 1; justify-content: center; }
		.ann-center .emoji { font-size: 18px; }
		.ann-center .message { font-weight: 600; color: #102027; }
		.ann-right { display: flex; align-items: center; gap: 12px; }
		.country { position: relative; }
		.country-btn {
			display: flex; align-items: center; gap: 8px;
			background: transparent; border: none; cursor: pointer;
			font-size: 14px; font-family: "Poppins", sans-serif; color: #102027;
			padding: 4px;
		}
		.country-btn img.flag { width: 20px; height: 20px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
		.country-btn .caret { font-size: 10px; margin-left: 2px; transition: transform 0.2s ease; }
		.country.is-open .country-btn .caret { transform: rotate(180deg); }
		.country-dropdown {
			position: absolute;
			top: calc(100% + 10px);
			right: 0;
			width: 220px;
			max-height: 280px;
			overflow-y: auto;
			background: #ffffff;
			border-radius: 10px;
			box-shadow: 0 20px 40px rgba(0,0,0,0.15);
			padding: 6px 0;
			opacity: 0;
			visibility: hidden;
			transform: translateY(6px);
			transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
			z-index: 1100;
		}
		.country.is-open .country-dropdown { opacity: 1; visibility: visible; transform: translateY(0); }
		.country-option {
			display: flex; align-items: center; gap: 10px;
			padding: 8px 16px;
			font-size: 14px; color: #102027;
			cursor: pointer;
		}
		.country-option:hover { background: #f5f5f5; }
		.country-option img.flag { width: 20px; height: 20px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
		.socials { display: flex; gap: 8px; }
		.social { display: inline-flex; align-items: center; justify-content: center; padding: 0 6px; text-decoration: none; color: #102027; }
		.social i { font-size: 16px; }
		.social:hover { opacity: 0.75; }

		@media (max-width: 767.98px) {
			.announce-inner { flex-direction: column; gap: 8px; padding: 8px 12px; text-align: center; }
			.ann-left { order: 2; display: flex; justify-content: center; gap: 12px; width: 100%; }
			.ann-left a { margin-right: 0; font-size: 12px; }
			.ann-center { order: 1; width: 100%; margin: 4px 0; }
			.ann-center .message { font-size: 13px; }
			.ann-right { order: 3; width: 100%; justify-content: center; gap: 16px; }
		}

		/* ================================================
		LOGO / SEARCH BAR (sits between Announce Bar and the category navbar)
		================================================ */
		#top-header {
			background: #ffffff;
			border-bottom: 1px solid #eee;
			padding: 8px 0;
			position: relative;
			z-index: 1002;
		}
		.top-header-inner {
			display: flex;
			align-items: center;
			justify-content: space-between;
			flex-wrap: wrap;
			gap: 16px;
			max-width: 1200px;
			margin: 0 auto;
			padding: 0 20px;
		}

		/* Hamburger / menu icon — sits before the search box */
		.menu-toggle-btn {
			order: 0;
			flex-shrink: 0;
			background: none;
			border: none;
			padding: 6px;
			display: flex;
			align-items: center;
			justify-content: center;
			cursor: pointer;
			color: #0f2027;
		}
		.menu-toggle-btn:hover { opacity: 0.7; }

		.search-box {
			flex: 1 1 260px;
			max-width: 320px;
			order: 1;
		}
		.search-box .input-group {
			border: 1px solid #d9d9d9;
			border-radius: 50px;
			overflow: hidden;
			display: flex;
		}
		.search-box input {
			border: none;
			padding: 6px 18px;
			font-size: 14px;
			color: #333;
			flex: 1;
		}
		.search-box input:focus { box-shadow: none; outline: none; }
		.search-box input::placeholder { color: #999; }
		.search-box .btn-search {
			background: #fff;
			border: none;
			padding: 0 12px;
			color: #0f2027;
			cursor: pointer;
		}
		.site-logo {
			order: 2;
			text-align: center;
			flex: 1 1 200px;
		}
		.site-logo p { margin: 0; padding: 0; }
		.site-logo .logo-title {
			font-family: "Fraunces", serif;
			font-size: 24px;
			font-weight: 700;
			color: #0f2027;
			line-height: 1;
			margin-bottom: 2px;
		}
		.site-logo .logo-subtitle {
			font-family: "Fraunces", serif;
			font-size: 10px;
			font-style: italic;
			color: #0f2027;
			letter-spacing: 2px;
			text-transform: uppercase;
			line-height: 1;
		}
		.header-actions {
			order: 3;
			display: flex;
			align-items: center;
			gap: 16px;
			flex: 1 1 260px;
			justify-content: flex-end;
		}
		.header-actions a {
			color: #0f2027;
			text-decoration: none;
			display: flex;
			align-items: center;
			gap: 8px;
			font-size: 14px;
			font-weight: 500;
			white-space: nowrap;
		}
		.header-actions a:hover { opacity: 0.7; }
		.cart-icon-wrap {
			position: relative;
			width: 36px; height: 36px;
			border: 1px solid #d9d9d9;
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
		}
		.cart-count {
			position: absolute;
			top: -5px; right: -5px;
			background: #c0392b;
			color: #fff;
			font-size: 10px;
			font-weight: 700;
			width: 16px; height: 16px;
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
		}

		@media (max-width: 767.98px) {
			.top-header-inner {
				flex-direction: column;
				align-items: center;
				gap: 12px;
				padding: 10px 16px;
			}
			.menu-toggle-btn { order: 0; align-self: flex-start; margin-bottom: -8px; }
			.site-logo { order: 1; width: 100%; margin-bottom: 4px; }
			.search-box { order: 2; width: 100%; max-width: 100%; }
			.header-actions { order: 3; width: 100%; justify-content: center; gap: 18px; }
			.header-actions .action-text { display: none; }
		}

		/* ================================================
		MAIN NAVBAR
		================================================ */
		.main-navbar {
			background-color: #0f2027;
			height: auto;
			padding: 14px 0;

			position: sticky;
			top: 0;
			left: 0;
			width: 100%;
			z-index: 1000;
			transition: transform 0.35s ease;
		}

		.main-navbar.nav-hidden {
			transform: translateY(-100%);
		}

		.main-navbar .nav-link {
			color: #ffffff !important;
			font-weight: 600;
			font-size: 15px;
			display: flex;
			align-items: center;
			gap: 6px;
			padding: 6px 16px !important;
		}

		.main-navbar .nav-link:hover {
			opacity: 0.8;
		}

		.main-navbar .nav-link::after {
			display: none;
		}

		.dropdown-arrow {
			font-size: 11px;
			margin-left: 2px;
		}

		/* Growing underline hover effect — main menu items (left to right, shrinks back on unhover) */
		.main-navbar .nav-link .nav-text {
			position: relative;
			display: inline-block;
		}
		.main-navbar .nav-link .nav-text::after {
			content: "";
			position: absolute;
			left: 0;
			bottom: -1px;
			width: 100%;
			height: 1px;
			background:currentColor;
			transform: scaleX(0);
			transform-origin: right;
			transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
		}
		.main-navbar .nav-link:hover .nav-text::after,
		.main-navbar .nav-item.has-mega.mega-open > .nav-link .nav-text::after {
			transform: scaleX(1);
			transform-origin: left;
		}

		.btn-on-sale {
			background-color: #c0392b;
			color: #ffffff;
			font-weight: 600;
			font-size: 14px;
			padding: 8px 22px;
			border-radius: 50px;
			border: none;
			text-decoration: none;
			white-space: nowrap;
		}
		.btn-on-sale:hover {
			background-color: #a83224;
			color: #ffffff;
		}

		/* Regular small dropdowns coming from the dynamic $menu loop */
		.main-navbar .dropdown-menu {
			display: block;
			opacity: 0;
			visibility: hidden;
			transform: translateY(10px);
			transition: all 0.3s ease;
			pointer-events: none;
			border: none;
			border-radius: 10px;
			margin-top: 10px;
			padding: 10px 0;
			min-width: 200px;
		}

		.main-navbar .dropdown:hover > .dropdown-menu {
			opacity: 1;
			visibility: visible;
			transform: translateY(0);
			pointer-events: auto;
		}

		.main-navbar .dropend .dropdown-menu {
			top: 0;
			left: 100%;
			margin-top: 0;
			transform: translateX(10px);
		}

		.main-navbar .dropend:hover > .dropdown-menu {
			transform: translateX(0);
		}

		.main-navbar .dropdown-item {
			font-size: 14px;
			padding: 8px 20px;
		}
		.main-navbar .dropdown-item:hover {
			background-color: #f2f2f2;
		}

		/* Nested (flyout) items — e.g. "Collections", "Product Gallery" inside Pages —
		get a small "›" indicator on the right so it's clear they open a sub-panel */
		.main-navbar .dropend > .dropdown-item {
			display: flex;
			align-items: center;
			justify-content: space-between;
		}
		.main-navbar .dropend > .dropdown-item::after {
			content: "\203A";
			font-size: 16px;
			color: #999;
			border: none;
		}

		.main-navbar .navbar-toggler {
			border-color: rgba(255, 255, 255, 0.4);
		}
		.main-navbar .navbar-toggler-icon {
			filter: invert(1);
		}

		/* ================================================
		MEGA MENU — "Shop by Categories" (static, separate from the loop)
		================================================ */

		/* IMPORTANT FIX: Bootstrap's .dropdown class sets "position: relative"
		on this <li>, which would make the mega-menu's "width: 100%" only as
		wide as this single menu item. We cancel that here so the mega-menu
		instead positions against .main-navbar (which is full page width). */
		.nav-item.has-mega {
			position: static;
		}

		.mega-menu {
			position: absolute;
			top: 100%;
			left: 0;
			width: 100%;
			background: #ffffff;
			box-shadow: 0 20px 40px rgba(0,0,0,0.12);
			border-top: 1px solid #eee;

			opacity: 0;
			visibility: hidden;
			transform: translateY(8px);
			transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s ease;
			pointer-events: none;
		}
		/* Shown when JS adds "mega-open" (instead of pure :hover) — JS uses a
		small delay so briefly crossing a gap while moving the mouse down
		into the panel doesn't accidentally close it. */
		.nav-item.has-mega.mega-open .mega-menu {
			opacity: 1;
			visibility: visible;
			transform: translateY(0);
			pointer-events: auto;
		}

		.mega-menu-inner {
			max-width: 1200px;
			margin: 0 auto;
			padding: 32px 20px;
			display: flex;
			gap: 40px;
		}

		/* LEFT — category tabs. Hovering one swaps the right-hand grid */
		.mega-menu-categories {
			width: 260px;
			flex-shrink: 0;
			border-right: 1px solid #eee;
			padding-right: 24px;
		}
		.mega-menu-categories a {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 14px 16px;
			border-radius: 8px;
			color: #0f2027;
			text-decoration: none;
			font-size: 15px;
			font-weight: 500;
			transition: background-color 0.2s ease;
		}
		.mega-menu-categories a.is-active {
			background-color: #f5f5f5;
		}
		.mega-menu-categories a .cat-text {
			position: relative;
			display: inline-block;
		}
		.mega-menu-categories a .cat-text::after {
			content: "";
			position: absolute;
			left: 0;
			bottom: -3px;
			width: 100%;
			height: 1px;
			background: #0f2027;
			transform: scaleX(0);
			transform-origin: right;
			transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
		}
		.mega-menu-categories a:hover .cat-text::after,
		.mega-menu-categories a.is-active .cat-text::after {
			transform: scaleX(1);
			transform-origin: left;
		}
		.mega-menu-categories a i {
			font-size: 13px;
			color: #999;
		}

		/* RIGHT — one product grid per category, only one visible at a time */
		.mega-menu-products {
			flex: 1;
			display: none;
			grid-template-columns: repeat(4, 1fr);
			gap: 24px;
		}
		.mega-menu-products.is-active {
			display: grid;
		}
		.mega-menu-product {
			text-decoration: none;
			display: block;
		}
		.mega-menu-product img {
			width: 100%;
			aspect-ratio: 1 / 1;
			object-fit: cover;
			border-radius: 12px;
			display: block;
		}
		.mega-menu-product .label {
			margin-top: 10px;
			font-size: 14px;
			font-weight: 600;
			color: #0f2027;
		}

		@media (max-width: 991.98px) {
			.mega-menu { position: static; box-shadow: none; opacity: 1; visibility: visible; transform: none; pointer-events: auto; display: none; }
			.nav-item.has-mega.show .mega-menu { display: block; }
			.mega-menu-inner { flex-direction: column; padding: 16px; }
			.mega-menu-categories { width: 100%; border-right: none; padding-right: 0; border-bottom: 1px solid #eee; margin-bottom: 16px; }
			.mega-menu-products { grid-template-columns: repeat(2, 1fr); }
		}

		@media (max-width: 991px) {
			.main-navbar .navbar-nav {
				gap: 6px;
				padding-top: 12px;
			}
			.btn-on-sale {
				display: inline-block;
				margin-top: 8px;
			}
		}

		/* ================================================
		SUBCATEGORY MEGA MENU — Skin Care / Makeup / Hair Care
		(text columns + a "Trending Products" column with images,
		same .mega-menu wrapper/size as "Shop by Categories" above,
		just a different inner layout)
		================================================ */
		.mega-menu-simple-inner {
			max-width: 1200px;
			margin: 0 auto;
			padding: 32px 20px;
			display: flex;
			gap: 32px;
			align-items: flex-start;
		}

		.mm-cols-group {
			display: flex;
			flex: 1;
			gap: 24px;
			min-width: 0;
		}

		.mm-col {
			flex: 1;
			min-width: 120px;
			border-right: 1px solid #eeeeee;
			padding-right: 20px;
		}
		.mm-col:last-child {
			border-right: none;
		}
		.mm-col h4 {
			font-family: "Poppins", sans-serif;
			font-size: 15px;
			font-weight: 700;
			color: #0f2027;
			margin: 0 0 14px;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}
		.mm-col a {
			display: block;
			padding: 6px 0;
			color: #555;
			text-decoration: none;
			font-size: 14px;
			position: relative;
			width: fit-content;
			white-space: nowrap;
		}
		.mm-col a::after {
			content: "";
			position: absolute;
			left: 0;
			bottom: 6px;
			width: 100%;
			height: 1px;
			background:currentColor;
			transform: scaleX(0);
			transform-origin: right;
			transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
		}
		.mm-col a:hover {
			color: #0f2027;
		}
		.mm-col a:hover::after {
			transform: scaleX(1);
			transform-origin: left;
		}

		.mm-trending {
			width: 380px;
			flex-shrink: 0;
			border-left: 1px solid #eeeeee;
			padding-left: 28px;
		}
		.mm-trending h4 {
			font-family: "Poppins", sans-serif;
			font-size: 16px;
			font-weight: 700;
			color: #0f2027;
			margin: 0 0 16px;
		}
		.mm-trending-grid {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 16px;
		}
		.mm-trending-card {
			text-decoration: none;
			display: block;
			position: relative;
		}
		.mm-trending-card .mm-badge {
			position: absolute;
			top: 8px;
			left: 8px;
			font-size: 10px;
			font-weight: 600;
			padding: 3px 8px;
			border-radius: 50px;
			color: #ffffff;
			z-index: 2;
		}
		.mm-trending-card .mm-badge.badge-sale { background-color: #c0392b; }
		.mm-trending-card .mm-badge.badge-new { background-color: #0f2027; }
		.mm-trending-card .mm-img-wrap {
			background: #f5f5f5;
			border-radius: 10px;
			overflow: hidden;
			aspect-ratio: 1 / 1;
		}
		.mm-trending-card img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
		}
		.mm-trending-card .mm-p-name {
			margin-top: 8px;
			font-size: 13px;
			font-weight: 600;
			color: #0f2027;
			line-height: 1.2;
		}
		.mm-trending-card .mm-p-price {
			margin-top: 4px;
			font-size: 13px;
		}
		.mm-trending-card .price-sale {
			color: #c0392b;
			font-weight: 700;
			margin-right: 6px;
		}
		.mm-trending-card .price-old {
			color: #999;
			text-decoration: line-through;
			font-size: 12px;
		}

		@media (max-width: 991.98px) {
			.mega-menu-simple-inner { flex-direction: column; padding: 16px; gap: 24px; }
			.mm-cols-group { flex-direction: column; gap: 16px; }
			.mm-col { width: 100%; border-right: none; padding-right: 0; border-bottom: 1px solid #eee; padding-bottom: 16px; }
			.mm-trending { width: 100%; border-left: none; padding-left: 0; border-top: 1px solid #eee; padding-top: 16px; }
			.mm-trending-grid { grid-template-columns: repeat(2, 1fr); }
		}

		/* ================================================
		BEST SELLERS MEGA MENU — left promo banner + 4 columns,
		each column holding two stacked link-groups
		================================================ */
		.mm-banner {
			width: 240px;
			flex-shrink: 0;
			border-radius: 16px;
			overflow: hidden;
			position: relative;
			color: #ffffff;
			background-size: cover;
			background-position: center;
			min-height: 320px;
			padding: 24px 22px;
			display: flex;
			flex-direction: column;
			justify-content: flex-end;
		}
		.mm-banner::before {
			content: "";
			position: absolute;
			inset: 0;
			background: linear-gradient(180deg, rgba(15,32,39,0) 30%, rgba(15,32,39,0.55) 100%);
		}
		.mm-banner .banner-tag,
		.mm-banner h3,
		.mm-banner .btn-banner {
			position: relative;
			z-index: 2;
		}
		.mm-banner .banner-tag {
			font-family: "Fraunces", serif;
			font-style: italic;
			font-size: 14px;
		}
		.mm-banner h3 {
			font-family: "Fraunces", serif;
			font-size: 26px;
			line-height: 1.15;
			margin: 8px 0 18px;
		}
		.mm-banner .btn-banner {
			background: #ffffff;
			color: #0f2027;
			padding: 10px 22px;
			border-radius: 50px;
			text-decoration: none;
			font-weight: 600;
			font-size: 14px;
			width: fit-content;
		}

		.mm-cols-wrap {
			display: flex;
			flex: 1;
			gap: 32px;
		}
		.mm-cols-wrap .mm-col {
			width: auto;
			flex: 1;
		}
		.mm-cols-wrap .mm-group + .mm-group {
			margin-top: 28px;
		}

		@media (max-width: 991.98px) {
			.mm-cols-wrap { flex-direction: column; gap: 24px; }
			.mm-banner { width: 100%; }
		}
	}

	$_section {
		{{= &custom_css}}
	}
</style>

<section class="$_s_class-mainheader">

	<!-- ANNOUNCEMENT BAR (pink) -->
	<div id="announce-bar">
		<div class="announce-inner">
			<div class="ann-left">
				<a href="#">Help Center</a>
				<a href="#">Find a Store</a>
				<a href="#">Contact</a>
			</div>
			<div class="ann-center">
				<span class="emoji">🤙</span>
				<span class="message">Free Express Shipping on orders $120!</span>
