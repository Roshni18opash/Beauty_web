		</svg>
		<span class="action-text">Find a Store</span>
	</a>
	<a href="#">
		<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
		fill="none" stroke="currentColor" stroke-width="2"
		stroke-linecap="round" stroke-linejoin="round">
		<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
		<circle cx="12" cy="7" r="4"></circle>
	</svg>
	<span class="action-text">Sign in/ Register</span>
</a>
<a href="#" class="cart-icon-wrap">
	<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
	fill="none" stroke="currentColor" stroke-width="2"
	stroke-linecap="round" stroke-linejoin="round">
	<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
	<path d="M3 6h18"></path>
	<path d="M16 10a4 4 0 0 1-8 0"></path>
</svg>
<span class="cart-count">2</span>
</a>
</div>

</div>
</header>
<!-- END LOGO / SEARCH BAR -->

<nav class="navbar navbar-expand-lg main-navbar" id="mainNavbar">
	<div class="container">

		<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
			<span class="navbar-toggler-icon"></span>
		</button>

		<div class="collapse navbar-collapse justify-content-center" id="navMenu">
			<ul class="navbar-nav align-items-lg-center gap-lg-2">

				<!-- ============================================
				"Shop by Categories" — static mega menu item
				(NOT part of the dynamic $menu loop below)
				============================================ -->
				<li class="nav-item dropdown has-mega">
					<a class="nav-link" href="#">
						<span class="nav-text">Shop by Categories</span> <i class="bi bi-chevron-down dropdown-arrow"></i>
					</a>

					<div class="mega-menu">
						<div class="mega-menu-inner">

							<!-- LEFT: category tabs -->

							<div class="mega-menu-categories">
								<a href="#" data-cat="skincare" class="is-active"><span class="cat-text">Skincare</span> <i class="bi bi-chevron-right"></i></a>
								<a href="#" data-cat="haircare"><span class="cat-text">Hair Care</span> <i class="bi bi-chevron-right"></i></a>
								<a href="#" data-cat="bodycare"><span class="cat-text">Body Care</span> <i class="bi bi-chevron-right"></i></a>
								<a href="#" data-cat="makeup"><span class="cat-text">Make Up</span> <i class="bi bi-chevron-right"></i></a>
							</div>

							<!-- RIGHT: one grid per category, JS shows/hides based on hover -->

							<!-- SKINCARE grid (shown by default) -->
							<div class="mega-menu-products is-active" data-cat-panel="skincare">
								<a href="#" class="mega-menu-product">
									<img src="https://picsum.photos/seed/megamenu1/400/400" alt="New Arrivals">
									<div class="label">New Arrivals</div>
								</a>

							</div>

							<!-- HAIR CARE grid -->
							<div class="mega-menu-products" data-cat-panel="haircare">
								<a href="#" class="mega-menu-product">
									<img src="https://picsum.photos/seed/megamenu9/400/400" alt="New Arrivals">
									<div class="label">New Arrivals</div>
								</a>

							</div>

							<!-- BODY CARE grid -->
							<div class="mega-menu-products" data-cat-panel="bodycare">
								<a href="#" class="mega-menu-product">
									<img src="https://picsum.photos/seed/megamenu17/400/400" alt="New Arrivals">
									<div class="label">New Arrivals</div>
								</a>

							</div>

							<!-- MAKE UP grid -->
							<div class="mega-menu-products" data-cat-panel="makeup">
								<a href="#" class="mega-menu-product">
									<img src="https://picsum.photos/seed/megamenu25/400/400" alt="New Arrivals">
									<div class="label">New Arrivals</div>
								</a>

							</div>

						</div>
					</div>
				</li>

				<!-- DYNAMIC MENU ITEMS WITH CONDITIONAL DROPDOWN DESIGNS -->
				{{with each $menu as $m}}
					{{$is_shop_by_cat = ($m["content"] == "Shop by Categories" || $m["content"] == "Shop By Categories" || $m["content"] == "Shop by Category" || $m["content"] == "Shop By Category")}}
					{{if !$is_shop_by_cat}}
					{{$has_children = system.arr.has_key($m, "children")}}
					{{$is_simple_dropdown = ($m["content"] == "Pages" || $m["content"] == "Theme Features" || $m["content"] == "pages" || $m["content"] == "theme features" || $m["content"] == "Features")}}

					{{if $is_simple_dropdown}}
						<!-- DESIGN 2 (Image 2): Standard vertical dropdown with flyout submenus for Pages & Features -->
						<li class="nav-item {{if $has_children}}dropdown{{endif}}">
							<a class="nav-link {{if $has_children}}dropdown-toggle{{endif}}"
							   href="{{= system.advanced.get_link($m['link'])}}"
							   {{if $has_children}}data-bs-toggle="dropdown"{{endif}}>
								<span class="nav-text">{{= $m["content"]}}</span>
								{{if $has_children}}
									<i class="bi bi-chevron-down dropdown-arrow"></i>
								{{endif}}
							</a>

							{{if $has_children}}
								<ul class="dropdown-menu">
									{{with each $m["children"] as $c}}
										{{$has_subchildren = system.arr.has_key($c, "children")}}
										<li class="{{if $has_subchildren}}dropdown dropend{{endif}}">
											<a class="dropdown-item {{if $has_subchildren}}dropdown-toggle{{endif}}"
											   href="{{= system.advanced.get_link($c['link'])}}"
											   {{if $has_subchildren}}data-bs-toggle="dropdown"{{endif}}>
												{{= $c["content"]}}
											</a>
											{{if $has_subchildren}}
												<ul class="dropdown-menu">
													{{with each $c["children"] as $subc}}
														<li>
															<a class="dropdown-item" href="{{= system.advanced.get_link($subc['link'])}}">
																{{= $subc["content"]}}
															</a>
														</li>
													{{endwith}}
												</ul>
											{{endif}}
										</li>
									{{endwith}}
								</ul>
							{{endif}}
						</li>
					{{else}}
						<!-- DESIGN 1 (Image 1): Full-width Mega Menu for all categories (Skin Care, Hair Care, Makeup, etc.) -->
						<li class="nav-item {{if $has_children}}dropdown has-mega{{endif}}">
							<a class="nav-link {{if $has_children}}dropdown-toggle{{endif}}"
							   href="{{= system.advanced.get_link($m['link'])}}"
							   {{if $has_children}}data-bs-toggle="dropdown"{{endif}}>
								<span class="nav-text">{{= $m["content"]}}</span>
								{{if $has_children}}
									<i class="bi bi-chevron-down dropdown-arrow"></i>
								{{endif}}
							</a>

							{{if $has_children}}
								<div class="mega-menu">
									<div class="mega-menu-simple-inner">
										<div class="mm-cols-group">
											{{$first_child = $m["children"][0]}}
											{{$has_groups = system.arr.has_key($first_child, "children")}}

											{{if $has_groups}}
												<!-- Nested Category Groups (e.g. Face, Eye, Lip, Skin care...) -->
												{{with each $m["children"] as $c}}
													{{$c_has_sub = system.arr.has_key($c, "children")}}
													<div class="mm-col">
														<h4>{{= $c["content"]}}</h4>
														{{if $c_has_sub}}
															{{with each $c["children"] as $subc}}
																<a href="{{= system.advanced.get_link($subc['link'])}}">{{= $subc["content"]}}</a>
															{{endwith}}
														{{endif}}
													</div>
												{{endwith}}
											{{else}}
												<!-- Flat List of Subcategories -->
												<div class="mm-col">
													<h4>{{= $m["content"]}}</h4>
													{{with each $m["children"] as $c}}
														<a href="{{= system.advanced.get_link($c['link'])}}">{{= $c["content"]}}</a>
													{{endwith}}
												</div>
											{{endif}}
										</div>

										<div class="mm-trending">
											<h4>Trending Products</h4>
											<div class="mm-trending-grid">
												<a href="#" class="mm-trending-card">
													<div class="mm-img-wrap">
														<img src="https://picsum.photos/seed/makeup-trend1/400/400" alt="Barrier Restore Serum">
													</div>
													<div class="mm-p-name">Barrier Restore Serum</div>
													<div class="mm-p-price">
														<span class="price-sale">$36.00</span>
													</div>
												</a>
												<a href="#" class="mm-trending-card">
													<span class="mm-badge badge-new">New</span>
													<div class="mm-img-wrap">
														<img src="https://picsum.photos/seed/makeup-trend2/400/400" alt="Balancing Hypotonic">
													</div>
													<div class="mm-p-name">Balancing Hypotonic</div>
													<div class="mm-p-price">
														<span class="price-sale">$37.00</span>
													</div>
												</a>
												<a href="#" class="mm-trending-card">
													<span class="mm-badge badge-sale">Sale</span>
													<div class="mm-img-wrap">
														<img src="https://picsum.photos/seed/makeup-trend3/400/400" alt="Blanca Scented Candle">
													</div>
													<div class="mm-p-name">Blanca Scented Candle</div>
													<div class="mm-p-price">
														<span class="price-sale">$35.00</span>
														<span class="price-old">$60.00</span>
													</div>
												</a>
											</div>
										</div>

									</div>
								</div>
							{{endif}}
						</li>
					{{endif}}
					{{endif}}
				{{endwith}}

				<li class="nav-item">
					<a class="btn-on-sale" href="{{= &on_sale_link}}">{{= &on_sale_text}}</a>
				</li>

				</ul>
			</div>

		</div>
	</nav>
</section>

<script>
	document.addEventListener('DOMContentLoaded', function () {

		// Main navbar just stays sticky at the top of the viewport
		// (position: sticky; top: 0 in CSS handles this — no hide/show on scroll)

		// Announcement bar: custom flag dropdown
		const countryWidget = document.getElementById('country-widget');
		const countryBtn = document.getElementById('country-btn');
		const countryDropdown = document.getElementById('country-dropdown');
		const countryLabel = document.getElementById('country-label');
		const countryBtnFlag = countryBtn ? countryBtn.querySelector('img.flag') : null;
		const message = document.querySelector('.ann-center .message');

		const shippingByCode = {
			us: 'Free Express Shipping on orders $120!',
			ca: 'Free Express Shipping on orders CAD $160!',
			gb: 'Free Express Shipping on orders £90!'
		};

		if (countryBtn && countryDropdown) {
			countryBtn.addEventListener('click', function (e) {
				e.stopPropagation();
				countryWidget.classList.toggle('is-open');
			});

			document.addEventListener('click', function () {
				countryWidget.classList.remove('is-open');
			});

			countryDropdown.querySelectorAll('.country-option').forEach(function (opt) {
				opt.addEventListener('click', function () {
					const code = opt.getAttribute('data-code');
					const label = opt.getAttribute('data-label');
					if (countryLabel) countryLabel.textContent = label;
					if (countryBtnFlag) countryBtnFlag.src = 'https://flagcdn.com/w80/' + code + '.png';
					if (message) message.textContent = shippingByCode[code] || 'Free Express Shipping on orders $120!';
					countryWidget.classList.remove('is-open');
				});
			});
		}

		// Mega menu: OPEN / CLOSE with a small delay
		// (this replaces pure CSS :hover so a brief gap while moving the
		// mouse down into the panel doesn't accidentally close it)
		// Handles ALL mega-menu items ("Shop by Categories", "Best Sellers",
		// "Skin Care", "Makeup", "Hair Care") independently.
		const megaItems = document.querySelectorAll('.nav-item.has-mega');

		megaItems.forEach(function (megaItem) {
			let closeTimer = null;

			function openMega() {
				clearTimeout(closeTimer);          // cancel any pending close
				megaItem.classList.add('mega-open');
			}

			function scheduleCloseMega() {
				closeTimer = setTimeout(function () {
					megaItem.classList.remove('mega-open');
				}, 250); // 250ms buffer before it actually closes
			}

			// works whether the mouse is over the nav item OR the panel itself
			megaItem.addEventListener('mouseenter', openMega);
			megaItem.addEventListener('mouseleave', scheduleCloseMega);
		});

		// Mega menu: hovering a left category swaps the right-side image grid
		// (only relevant inside "Shop by Categories")
		const catLinks = document.querySelectorAll('.mega-menu-categories a[data-cat]');
		catLinks.forEach(function (link) {
			link.addEventListener('mouseenter', function () {
				const cat = link.getAttribute('data-cat');

				// remove active state from all tabs and all grids
				document.querySelectorAll('.mega-menu-categories a').forEach(function (a) {
					a.classList.remove('is-active');
				});
				document.querySelectorAll('.mega-menu-products').forEach(function (panel) {
					panel.classList.remove('is-active');
				});

				// activate only the hovered tab + its matching grid
				link.classList.add('is-active');
				const panel = document.querySelector('.mega-menu-products[data-cat-panel="' + cat + '"]');
				if (panel) panel.classList.add('is-active');
			});
		});

		// Mobile: tap the mega-menu nav items toggles them open/closed
		document.querySelectorAll('.has-mega > .nav-link').forEach(function (link) {
			link.addEventListener('click', function (e) {
				if (window.innerWidth <= 991.98) {
					e.preventDefault();
					this.closest('.has-mega').classList.toggle('show');
				}
			});
		});
	});
</script>