			<div class="ann-right">
				<div class="country" id="country-widget">
					<button type="button" class="country-btn" id="country-btn">
						<img class="flag" src="https://flagcdn.com/w80/us.png" alt="">
						<span id="country-label">United States (USD $)</span>
						<i class="bi bi-chevron-down caret"></i>
					</button>
					<div class="country-dropdown" id="country-dropdown">
						<div class="country-option" data-code="us" data-label="United States (USD $)"><img class="flag" src="https://flagcdn.com/w80/us.png" alt="">United States (USD $)</div>
						<div class="country-option" data-code="au" data-label="Australia (USD $)"><img class="flag" src="https://flagcdn.com/w80/au.png" alt="">Australia (USD $)</div>
						<div class="country-option" data-code="at" data-label="Austria (USD $)"><img class="flag" src="https://flagcdn.com/w80/at.png" alt="">Austria (USD $)</div>
						<div class="country-option" data-code="be" data-label="Belgium (USD $)"><img class="flag" src="https://flagcdn.com/w80/be.png" alt="">Belgium (USD $)</div>
						<div class="country-option" data-code="ca" data-label="Canada (CAD $)"><img class="flag" src="https://flagcdn.com/w80/ca.png" alt="">Canada (CAD $)</div>
						<div class="country-option" data-code="cz" data-label="Czechia (USD $)"><img class="flag" src="https://flagcdn.com/w80/cz.png" alt="">Czechia (USD $)</div>
						<div class="country-option" data-code="dk" data-label="Denmark (USD $)"><img class="flag" src="https://flagcdn.com/w80/dk.png" alt="">Denmark (USD $)</div>
						<div class="country-option" data-code="fi" data-label="Finland (USD $)"><img class="flag" src="https://flagcdn.com/w80/fi.png" alt="">Finland (USD $)</div>
						<div class="country-option" data-code="fr" data-label="France (USD $)"><img class="flag" src="https://flagcdn.com/w80/fr.png" alt="">France (USD $)</div>
						<div class="country-option" data-code="de" data-label="Germany (USD $)"><img class="flag" src="https://flagcdn.com/w80/de.png" alt="">Germany (USD $)</div>
						<div class="country-option" data-code="gb" data-label="United Kingdom (£)"><img class="flag" src="https://flagcdn.com/w80/gb.png" alt="">United Kingdom (£)</div>
					</div>
				</div>
				<div class="socials">
					<a href="#" class="social" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
					<a href="#" class="social" aria-label="X"><i class="bi bi-twitter-x"></i></a>
					<a href="#" class="social" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
					<a href="#" class="social" aria-label="TikTok"><i class="bi bi-tiktok"></i></a>
				</div>
			</div>
