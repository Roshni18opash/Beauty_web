<style>
	$_section{

		.new-arrivals{
			background-color:{{= &section_bg}};
		}

		{{if &p_l_r_md == 'custom'}}
			.new-arrivals{
				padding-left: {{= &custom_padding}}px !important;
				padding-right: {{= &custom_padding}}px !important;
			}
		{{endif}}

		/* ─── Section Header ─── */
		.section-header {
			display: flex;
			justify-content: space-between;
			align-items: flex-end;
			margin-bottom: 28px;
		}

		.section-title {
			font-family: 'Fraunces', serif;
			color:{{= &title_color}};
			font-size:{{= &title_size}}px;
			font-weight:{{= &title_weight}};
			margin-bottom: 8px;
		}

		{{if &main_title != 'y'}}
			.section-title {
				visibility: hidden !important;
			}
		{{endif}}

		.section-desc {
			font-size:{{= &desc_size}}px;
			color:{{= &desc_clr}};
			font-weight:{{= &desc_weight}};
			font-family: 'Figtree', sans-serif;
		}

		{{if &description != 'y'}}
			.section-desc {
				visibility: hidden !important;
			}
		{{endif}}

		/* ─── Tabs ─── */
		.tabs {
			display: flex;
			gap: 22px;
			/* font-family: 'Figtree' sans-serif; */
		}

		.tab {
			border: none;
			background: none;
			font-size:{{= &tab_size}}px;
			font-weight:{{= &tab_weight}};
			color:{{= &tab_color}};
			cursor: pointer;
			padding-bottom: 6px;
			position: relative;
			font-family: 'Figtree',sans-serif;
		}

		.tab::after {
			content: '';
			position: absolute;
			bottom: 0;
			left: 0;
			width: 100%;
			height: 1px;
			background:currentColor;
			transform: scaleX(0);
			transform-origin: right center;
			transition: transform 0.35s ease;
		}

		/* .tab:hover::after  */
		/* 	transform-origin: left center; */
		/* 	transform: scaleX(1); */
		/* } */

		.tab:hover:not(.active) {
			color:{{= &tab_active_color}};
		}

		.tab.active {
			color:{{= &tab_active_color}};
			/* background:-= &tab_active_color}}; */
		}

		.tab.active::after {
			transform: scaleX(1);
			transform-origin: left center;
		}

		/* ─── Products Track ─── */
		.products-track {
			display: flex;
			align-items: stretch;
			gap: 16px;
			overflow-x: auto;
			scroll-behavior: smooth;
			scrollbar-width: none;
			padding-bottom: 4px;
		}
		.products-track::-webkit-scrollbar { display: none; }

		/* ─── Product Card ─── */
		.product_card {
			flex: 0 0 220px;
			width: 220px;
			background:{{= &card_bg}};
			border: 1px solid #f3f3f3;
			border-radius:{{= &card_radius}}px;
			/* 24px */
			overflow: hidden;
			display: flex;
			flex-direction: column;
			box-shadow: 0 18px 55px rgba(15, 46, 60, 0.08);
		}

		/* ─── Card Image ─── */
		.card-image {
			position: relative;
			min-height: 260px;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 28px 16px 18px;
			overflow: hidden;
			border-radius: {{= &card_radius}}px;
		}

		.img-box {
			position: relative;
			width: 100%;
			display: grid;
			place-items: center;
		}

		.img-main {
			position: relative;
			z-index: 1;
			width: auto;
			height: auto;
			max-width: 90%;
			max-height: 200px;
			object-fit: contain;
			transition: opacity 0.35s ease;
			border-radius:{{= &card_radius}}px;
		}

		.img-alt {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
			opacity: 0;
			z-index: 0;
			transition: opacity 0.35s ease;
			border-radius:{{= &card_radius}}px;
		}

		.card-image:hover .img-main { opacity: 0; }
		.card-image:hover .img-alt  { opacity: 1; }

		/* ─── Badges ─── */
		.badge-new,
		.badge-sale {
			position: absolute;
			top: 12px;
			left: 12px;
			color: #fff;
			font-size: 0.65rem;
			font-weight: 600;
			padding: 5px 11px;
			border-radius: 50px;
			z-index: 2;
		}
		.badge-new  { background: #82b1a5; }
		.badge-sale { background: #d92f24; }

		/* ─── Buttons ─── */
		.btn-search,
		.btn-cart {
			position: absolute;
			border: none;
			cursor: pointer;
			opacity: 0;
			transition: opacity 0.3s, transform 0.3s;
			z-index: 3;
		}

		.btn-search {
			top: 12px;
			right: 12px;
			width: 36px;
			height: 36px;
			border-radius: 50%;
			background: #fff;
			display: flex;
			align-items: center;
			justify-content: center;
			transform: translate(8px, -8px);
		}

		.btn-cart {
			left: 12px;
			right: 12px;
			bottom: 12px;
			padding: 11px;
			border-radius:{{= &btn_radius}}px;
			/* 50px */
			background: {{= &btn_bg}};
			font-size:{{= &btn_text_size}}px;
			/* 12.8px */
			font-weight:{{= &btn_weight}};
			overflow: hidden;
			transform: translateY(16px);
			color:{{= &btn_txt_clr}}!important;
			transition: color 0.3s;

		}

		.btn-cart::before {
			content: '';
			position: absolute;
			inset: 0;
			background:{{= &btn_txt_clr}}!important;
			transform: scaleX(0);
			transform-origin: left;
			transition: transform 0.3s;

		}
		.btn-cart::before {
			z-index: 0;
		}

		.btn-cart span {
			position: relative;
			z-index: 1;
		}

		.btn-cart:hover::before { transform: scaleX(1); }
		.btn-cart:hover { color:{{= &btn_bg}} !important; }

		.card-image:has(.selling-fast) .btn-cart { bottom: 34px; }

		.card-image:hover .btn-search,
		.card-image:hover .btn-cart { opacity: 1; }
		.card-image:hover .btn-search { transform: translate(0, 0); }
		.card-image:hover .btn-cart   { transform: translateY(0); }

		/* ─── Card Info ─── */
		.card-info {
			padding: 18px 18px 20px;
			display: flex;
			flex-direction: column;
			gap: 8px;
			flex: 1;
		}

		.category {
			display: inline-block;
			font-size:{{= &cat_size}}px;
			/* 11px */
			font-weight:{{= &cat_weight}};
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color:{{= &cat_color}};
			margin-bottom: 6px;
			position: relative;
			padding-bottom: 2px;
			width: fit-content;
		}

		{{if &cat_title != 'y'}}
			.category {
				visibility: hidden !important;
			}
		{{endif}}


		.category::after {
			content: '';
			position: absolute;
			bottom: 0;
			left: 0;
			width: 100%;
			height: 0.5px !important;
			background: currentColor;
			transform: scaleX(0);
			transform-origin: right center;
			transition: transform 0.35s ease;
		}

		.category:hover::after {
			transform-origin: left center;
			transform: scaleX(1);
		}

		.name {
			display: inline-block;
			font-family: 'Inter', sans-serif;
			font-size:{{= &pro_size}}px;
			/* 15px */
			font-weight:{{= &pro_weight}};
			margin-bottom: 4px;
			line-height: 1.3;
			max-width: 100%;
			word-wrap: break-word;
			position: relative;
			padding-bottom: 2px;
			width: fit-content;
			color:{{= &pro_color}};
		}

		{{if &pro_title != 'y'}}
			.name {
				visibility: hidden !important;
			}
		{{endif}}


		.name::after {
			content: '';
			position: absolute;
			bottom: 0;
			left: 0;
			width: 100%;
			height: 0.5px !important;
			background: currentColor;
			transform: scaleX(0);
			transform-origin: right center;
			transition: transform 0.35s ease;
		}

		.name:hover::after {
			transform-origin: left center;
			transform: scaleX(1);
		}

		/* ─── Price ─── */
		.price-row {
			display: inline-flex;
			align-items: center;
			gap: 10px;
			flex-wrap: wrap;
		}
		/* ori price */
		.price {
			font-size:{{= &ori_size}}px;
			font-weight:{{= &ori_weight}};
			color:{{= &ori_clr}};
			margin: 0;
		}

		.price-sale {
			font-size:{{= &sale_size}}px;
			font-weight:{{= &sale_weight}};
			color:{{= &sale_color}};
			margin-right: 8px;
		}

		/* .price-original  */
		/* 	color: #E613D1; */
		/* 	font-size: 0.9rem; */
		/* 	text-decoration: line-through; */
		/* 	margin: 0; */
		/* } */

		/* ─── Hover Line (Shop All Link) ─── */
		.hover-line {
			position: relative;
			display: inline-block;
			cursor: pointer;
			overflow: visible;
		}

		.hover-line::after {
			content: '';
			position: absolute;
			left: 0;
			bottom: 0;
			width: 100%;
			height: 1px;
			background: currentColor;
			transform: scaleX(0);
			transform-origin: right center;
			transition: transform 0.35s ease;
		}

		.hover-line:hover::after,
		.hover-line:focus-visible::after {
			transform-origin: left center;
			transform: scaleX(1);
		}

		/* ─── Slider Footer ─── */
		.slider-footer {
			display: flex;
			align-items: center;
			gap: 20px;
			margin-top: 28px;
		}

		.scroll-bar-wrap {
			flex: 1;
			position: relative;
			height: 4px;
		}

		.scroll-track {
			width: 100%;
			height: 1px;
			background: #e4e4e4;
		}

		.scroll-thumb {
			position: absolute;
			left: 0;
			top: 50%;
			transform: translateY(-50%);
			height: 3px;
			width: 30%;
			background: #1a1a1a;
			transition: left 0.15s ease;
		}

		/* ─── Nav Buttons ─── */
		.slider-nav {
			display: flex;
			gap: 8px;
		}

		.nav-btn {
			position: relative;
			overflow: hidden;
			width: 40px;
			height: 40px;
			border-radius: 50%;
			border: 1px solid #e5e5e5;
			background: #fff;
			color: #0f2e3c;
			cursor: pointer;
			display: flex;
			align-items: center;
			justify-content: center;
			transition: color 0.3s ease, border-color 0.3s ease;
		}

		.nav-btn svg {
			position: relative;
			z-index: 1;
			stroke: currentColor;
			transition: stroke 0.3s ease;
		}

		.nav-btn::before {
			content: '';
			position: absolute;
			left: -100%;
			top: 0;
			width: 100%;
			height: 100%;
			background: #000;
			transition: left 0.3s ease;
			z-index: 0;
		}

		.nav-btn:hover::before { left: 0; }
		.nav-btn:hover {
			color: #fff;
			border-color: #000;
		}
		.nav-btn:hover svg,
		.nav-btn:hover svg path,
		.nav-btn:hover svg circle { stroke: #fff !important; }

		.nav-btn:disabled {
			opacity: 0.35;
			cursor: not-allowed;
		}
		.nav-btn:disabled::before { left: -100%; }
		.nav-btn:disabled:hover,
		.nav-btn[disabled]:hover {
			color: #0f2e3c;
			border-color: #e5e5e5;
		}
		.nav-btn:disabled svg,
		.nav-btn[disabled] svg,
		.nav-btn:disabled:hover svg,
		.nav-btn[disabled]:hover svg,
		.nav-btn:disabled svg path,
		.nav-btn[disabled] svg path,
		.nav-btn:disabled:hover svg path,
		.nav-btn[disabled]:hover svg path { stroke: currentColor !important; }

		/* ─── Desktop ─── */
		@media (min-width: 769px) {

			{{if &desktop != 'y'}}
				.new-arrivals {
					display: none !important;
				}
			{{endif}}

			.product_card {
				flex-basis: calc((100% - (16px * 5)) / 5.5);
				width: calc((100% - (16px * 5)) / 5.5);
			}
		}

		/* ─── Mobile ─── */
		@media (max-width: 768px) {

			{{if &mobile != 'y'}}
				.new-arrivals {
					display: none !important;
				}
			{{endif}}

			{{if &p_l_r == 'm_custom'}}
				.new-arrivals {
					padding-left: {{= &m_custom_padding}}px !important;
					padding-right: {{= &m_custom_padding}}px !important;
				}
			{{endif}}

			.new-arrivals {
				overflow-x: hidden;
			}

			.name::after,
			.category::after,
			.hover-line:hover::after,
			.hover-line:focus-visible::after {
				display: none !important;
			}

			.section-header {
				flex-direction: column;
				align-items: flex-start;
				gap: 16px;
			}

			.section-title { font-size: 2rem; }
		}
	}

	$_section { {{= &custom_css}} }
</style>

<section class="new-arrivals pt-md-{{= &p_md_top}} pb-md-{{= &p_md_bottom}} {{if p_l_r_md != 'custom'}}px-md-{{= &p_l_r_md}}{{endif}} pt-{{= &p_top}} pb-{{= &p_bottom}} {{if p_l_r != 'm_custom'}}px-{{= &p_l_r}}{{endif}}">

	<div class="{{= &section_spacing}}">

		<header class="section-header">
			<div>
				<h2 class="section-title">{{= &title}}</h2>
				<p class="section-desc">{{= &desc}}</p>
			</div>

			<div class="tabs">
				{{$a=0}}
				{{with each &collection as $btn at $i}}
					{{$pass_val=[$a,$i]}}
					{{use component $btn pass on [$pass_val]}}
				{{endwith}}
			</div>
		</header>

		<div class="slider-wrap">
			<div class="products-track" id="productsTrack">
				{{$a=1}}
				{{with each &collection as $img at $i}}
					{{$pass_val=[$a,$i]}}
					{{use component $img pass on [$pass_val]}}
				{{endwith}}
			</div>
		</div>

		<div class="slider-footer">
			<div class="scroll-bar-wrap">
				<div class="scroll-track"></div>
				<div class="scroll-thumb" id="scrollThumb"></div>
			</div>
			<div class="slider-nav">
				<button class="nav-btn" id="prevBtn" type="button" aria-label="Previous">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none"
					stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
			</button>
			<button class="nav-btn" id="nextBtn" type="button" aria-label="Next">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none"
				stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
		</button>
	</div>
</div>

</div>
</section>

<script>
	const track    = document.getElementById('productsTrack');
	const thumb    = document.getElementById('scrollThumb');
	const prevBtn  = document.getElementById('prevBtn');
	const nextBtn  = document.getElementById('nextBtn');

	const MIN_THUMB_WIDTH   = 30;
	const MAX_THUMB_WIDTH   = 100;
	const GAP_BETWEEN_CARDS = 16;

	thumb.style.width = MIN_THUMB_WIDTH + '%';
	thumb.style.left  = '0%';

	function setThumbWidth(width) {
		const safe = Math.min(MAX_THUMB_WIDTH, Math.max(MIN_THUMB_WIDTH, width));
		thumb.style.width = safe + '%';
	}

	function getThumbStep(scrollAmount) {
		const total = track.scrollWidth;
		return Math.round((scrollAmount / total) * 100 * 100) / 100;
	}

	function getVisibleCardWidth() {
		const visibleCard = track.querySelector('.product_card:not([style*="display: none"]):not([style*="display:none"])');
		return visibleCard ? visibleCard.offsetWidth + GAP_BETWEEN_CARDS : 220 + GAP_BETWEEN_CARDS;
	}

	function updateButtons() {
		const maxScroll = track.scrollWidth - track.clientWidth;
		const atStart   = track.scrollLeft <= 1;
		const atEnd     = track.scrollLeft >= maxScroll - 1;

		prevBtn.disabled = atStart;
		nextBtn.disabled = atEnd;

		if (atStart) setThumbWidth(MIN_THUMB_WIDTH);
		else if (atEnd) setThumbWidth(MAX_THUMB_WIDTH);
	}

	prevBtn.onclick = () => {
		if (track.scrollLeft <= 1) return;
		const cardWidth = getVisibleCardWidth();
		const scrollAmt = Math.min(cardWidth, track.scrollLeft);
		track.scrollBy({ left: -scrollAmt, behavior: 'smooth' });
		setThumbWidth(parseFloat(thumb.style.width) - getThumbStep(scrollAmt));
		setTimeout(updateButtons, 500);
	};

	nextBtn.onclick = () => {
		const maxScroll = track.scrollWidth - track.clientWidth;
		if (track.scrollLeft >= maxScroll - 1) return;
		const cardWidth = getVisibleCardWidth();
		const scrollAmt = Math.min(cardWidth, maxScroll - track.scrollLeft);
		track.scrollBy({ left: scrollAmt, behavior: 'smooth' });
		setThumbWidth(parseFloat(thumb.style.width) + getThumbStep(scrollAmt));
		setTimeout(updateButtons, 500);
	};

	function resetNav() {
		track.scrollLeft = 0;
		thumb.style.width = MIN_THUMB_WIDTH + '%';
		thumb.style.left  = '0%';
		setTimeout(updateButtons, 100);
	}

	document.querySelectorAll('.tab').forEach(tab => {
		tab.onclick = (e) => {
			e.preventDefault();

			const section    = document.querySelector('.new-arrivals');
			const sectionTop = section ? section.getBoundingClientRect().top : 0;

			const sel = tab.getAttribute('data-collection');
			document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
			tab.classList.add('active');

			document.querySelectorAll('.product_card').forEach(card => {
				card.style.display = (card.getAttribute('data-collection') === sel) ? '' : 'none';
			});

			if (section) {
				const newTop = section.getBoundingClientRect().top;
				const diff   = newTop - sectionTop;
				window.scrollBy({ top: diff, behavior: 'instant' });
			}

			resetNav();
		};
	});

	track.addEventListener('scroll', updateButtons);
	window.addEventListener('resize', updateButtons);
	updateButtons();
</script>