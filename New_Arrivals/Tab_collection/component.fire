<!-- Component template (unchanged – only comments added) -->
<!-----Component-----> 
{{$collection= system.collection.get_collection(&tab_coll)}}
{{$collection_prods= system.collection.get_collection_products(&tab_coll)}}

{{if $pass_val[0] == 0}}
	 {{if $pass_val[1] < 6}}
    <button class="tab {{if $pass_val[1] == 0}}active{{endif}}" type="button"
           
            data-collection="tab-{{= $pass_val[1]}}">{{= &tabtext}}</button>
		{{endif}}
{{endif}}

{{if $pass_val[0] == 1}}
	 {{if $pass_val[1] < 6}}
    {{with each $collection_prods as $collection}}
        {{$prods = system.product.get_product($collection)}}
        <article class="product_card"
                 data-collection="tab-{{= $pass_val[1]}}"
                 {{if $pass_val[1] != 0}}style="display:none;"{{endif}}>

            <div class="card-image">
                <!-- <span class="badge-new">New</span> -->
                <div class="img-box">
                    <img class="img-main"
                         src="https://cdn.flicksell.com/{{= $prods['main_img']}}"
                         alt="{{= $prods['name']}}">
                    <img class="img-alt"
                         src="https://cdn.flicksell.com/{{= $prods['images'][1]}}"
                         alt="{{= $prods['name']}} Hover">
                </div>
                <button class="btn-search" type="button" aria-label="Search">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="m21 21-4.3-4.3"/>
                    </svg>
                </button>
               <button class="btn-cart" type="button">
    <span>{{= &btn_txt}}</span>
</button>
            </div>

            <div class="card-info">
                <span class="category hover-line">{{= &cat_name}}</span>
                <h3 class="name hover-line">{{= $prods['name']}}</h3>
                <!-- price line is rendered by flicksell‑templates -->
                <flicksell-template-cart product-id="{{= $collection}}" no-auto-select>
				 <flicksell-template-product-price class="discounted-price price-sale">
					</flicksell-template-product-price>
                    <flicksell-template-product-mrp class="original-price price"></flicksell-template-product-mrp>
                   
                </flicksell-template-cart>
            </div>
        </article>
    {{endwith}}
{{endif}}
{{endif}}
<!-----component over----->