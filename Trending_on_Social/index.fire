<!-- ── Slider Footer (scroll bar + nav buttons) — EXACT same as provided code ── -->
<div class="slider-footer">
	<div class="scroll-bar-wrap">
		<div class="scroll-track"></div>
		<div class="scroll-thumb" id="scrollThumb"></div>
	</div>
	<div class="slider-nav">
		<button class="nav-btn" id="prevBtn" type="button" aria-label="Previous">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none"
			stroke="currentColor" stroke-width="2">
			<path d="m15 18-6-6 6-6"/>
		</svg>
	</button>
	<button class="nav-btn" id="nextBtn" type="button" aria-label="Next">
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none"
		stroke="currentColor" stroke-width="2">
		<path d="m9 18 6-6-6-6"/>
	</svg>
</button>
</div>
</div>

