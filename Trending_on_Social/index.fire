<style>
	/* html { scroll-behavior: smooth; } */


	$_section{


		-webkit-font-smoothing: antialiased;


		/* ── Section ───────────────────────────────────────────── */
		.social-section {
			background-color:{{= &section_bg}};
			padding: 52px 0 56px;
			overflow: hidden;
		}

		.social-container {
			width: 100%;
			max-width: 1300px;
			margin: 0 auto;
			padding: 0 40px;
		}

		/* ── Section Header ────────────────────────────────────── */
		.section-header {
			display: flex;
			justify-content: space-between;
			align-items: flex-end;
			margin-bottom: 28px;
		}

		/* Title — Fraunces serif, matches .fire template exactly */
		.section-title {
			font-family: 'Fraunces', serif;
			font-size: 32px;
			font-weight: 400;
			color: #1a1a1a;
			text-align: center;
			width: 100%;
			margin-bottom: 0;
		}

		/* ── Slider Wrap ───────────────────────────────────────── */
		.slider-wrap {
			/* overflow:hidden clips the left-bleed when track scrolls.
			Right-side 5th card peek is handled by padding-right on the track. */
			width: 100%;
			overflow: hidden;
		}

		/* ── Products Track — EXACT from .fire template ─────────── */
		.products-track {
			display: flex;
			align-items: stretch;
			gap: 16px;
			overflow-x: auto;
			scroll-behavior: smooth;
			scrollbar-width: none;
			padding-bottom: 4px;
			/* Right padding so last card has visible breathing room */
			padding-right: 40px;
		}

		.products-track::-webkit-scrollbar { display: none; }

		/* ── Social Card ───────────────────────────────────────── */
		/* flex-basis mirrors .fire template's card sizing */
		.social-card {
			/* Base width (mobile) — overridden by desktop calc below */
			flex: 0 0 220px;
			width: 220px;
			background: #fff;
			border: 1px solid #f3f3f3;
			border-radius: 14px;
			overflow: hidden;
			display: flex;
			flex-direction: column;
			box-shadow: 0 18px 55px rgba(15, 46, 60, 0.08);
			position: relative;
		}

		/* ── User Header ───────────────────────────────────────── */
		.card-user-header {
			display: flex;
			align-items: center;
			gap: 10px;
			padding: 12px 14px 10px;
			background: #fff;
		}

		/* Avatar circle with initial letter */
		.user-avatar {
			width: 34px;
			height: 34px;
			min-width: 34px;
			border-radius: 50%;
			background: linear-gradient(135deg, #c9a882, #e8c9a0);
			color: #fff;
			font-family: 'Figtree', sans-serif;
			font-size: 13px;
			font-weight: 700;
			display: flex;
			align-items: center;
			justify-content: center;
			text-transform: uppercase;
			border: 2px solid #f0e8df;
			overflow: hidden;
		}

		.avatar-img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			border-radius: 50%;
			display: block;
		}

		.user-info {
			display: flex;
			flex-direction: column;
			gap: 1px;
			flex: 1;
			min-width: 0;
		}

		.user-name {
			font-family: 'Figtree', sans-serif;
			font-size: 13px;
			font-weight: 600;
			color: #1a1a1a;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		.user-handle {
			font-family: 'Figtree', sans-serif;
			font-size: 11px;
			font-weight: 400;
			color: #888;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		/* TikTok icon — right side of header */
		.tiktok-icon {
			color: #1a1a1a;
			display: flex;
			align-items: center;
			justify-content: center;
			flex-shrink: 0;
		}

		/* ── Card Media (Video) ────────────────────────────────── */
		.card-media-wrap {
			position: relative;
			width: 100%;
			/* No aspect-ratio. padding-bottom creates consistent portrait height. */
			/* Matches original: tall portrait video cards */
			padding-bottom: 148%;
			overflow: hidden;
			background: #f0ede8;
			flex-shrink: 0;
		}

		.card-video {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
			object-position: center;
			display: block;
		}

		/* ── Play/Pause Button ─────────────────────────────────── */
		.play-btn {
			position: absolute;
			top: 50%;
			left: 50%;
			transform: translate(-50%, -50%);
			width: 48px;
			height: 48px;
			border-radius: 50%;
			border: none;
			background: rgba(0, 0, 0, 0.38);
			backdrop-filter: blur(4px);
			-webkit-backdrop-filter: blur(4px);
			display: flex;
			align-items: center;
			justify-content: center;
			cursor: pointer;
			z-index: 4;
			transition: background 0.25s ease, transform 0.2s ease;
		}

		.play-btn:hover {
			background: rgba(0, 0, 0, 0.55);
			transform: translate(-50%, -50%) scale(1.08);
		}

		/* Hide play button when video is playing */
		.play-btn.playing {
			opacity: 0;
			pointer-events: none;
		}

		/* Show on card hover even when playing */
		.card-media-wrap:hover .play-btn.playing {
			opacity: 1;
			pointer-events: auto;
		}

		/* ── Card Footer Info ──────────────────────────────────── */
		.card-footer-info {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 12px 14px;
			background: #fff;
			border-top: 1px solid #f3f3f3;
			gap: 8px;
		}

		.product-label {
			display: flex;
			align-items: center;
			gap: 10px;
			min-width: 0;
			flex: 1;
		}

		.product-image {
			width: 36px;
			height: 36px;
			object-fit: contain;
			border-radius: 4px;
			flex-shrink: 0;
			background: #f9f9f9;
		}

		.product-name {
			font-family: 'Figtree', sans-serif;
			font-size: 13.5px;
			font-weight: 600;
			color: #0f2e3c;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
			/* Underline hover — left to right */
			position: relative;
			padding-bottom: 1px;
		}

		.product-name::after {
			content: '';
			position: absolute;
			bottom: 0;
			left: 0;
			width: 100%;
			height: 0.5px;
			background: currentColor;
			transform: scaleX(0);
			transform-origin: right center;
			transition: transform 0.35s ease;
		}

		.card-footer-info:hover .product-name::after {
			transform: scaleX(1);
			transform-origin: left center;
		}

		/* Arrow link styled as premium circle button */
		.product-arrow {
			width: 32px;
			height: 32px;
			border-radius: 50%;
			background: #f4f7f6;
			color: #0f2e3c;
			text-decoration: none;
			display: flex;
			align-items: center;
			justify-content: center;
			flex-shrink: 0;
			font-size: 18px;
			font-weight: 600;
			line-height: 1;
			transition: background 0.25s ease, color 0.25s ease;
		}

		.product-arrow:hover {
			background: #0f2e3c;
			color: #fff;
		}

		/* ── Slider Footer — EXACT same as .fire template ──────── */
		.slider-footer {
			display: flex;
			align-items: center;
			gap: 20px;
			margin-top: 28px;
		}

		.scroll-bar-wrap {
			flex: 1;
			position: relative;
			height: 4px;
		}

		.scroll-track {
			width: 100%;
			height: 1px;
			background: #e4e4e4;
		}

		.scroll-thumb {
			position: absolute;
			left: 0;
			top: 50%;
			transform: translateY(-50%);
			height: 3px;
			width: 30%;
			background: #1a1a1a;
			transition: width 0.15s ease;
		}

		/* ── Nav Buttons — EXACT same as .fire template ─────────── */
		.slider-nav {
			display: flex;
			gap: 8px;
		}

		.nav-btn {
			position: relative;
			overflow: hidden;
			width: 40px;
			height: 40px;
			border-radius: 50%;
			border: 1px solid #e5e5e5;
			background: #fff;
			color: #0f2e3c;
			cursor: pointer;
			display: flex;
			align-items: center;
			justify-content: center;
			transition: color 0.3s ease, border-color 0.3s ease;
		}

		.nav-btn svg {
			position: relative;
			z-index: 1;
			stroke: currentColor;
			transition: stroke 0.3s ease;
		}

		.nav-btn::before {
			content: '';
			position: absolute;
			left: -100%;
			top: 0;
			width: 100%;
			height: 100%;
			background: #000;
			transition: left 0.3s ease;
			z-index: 0;
		}

		.nav-btn:hover::before { left: 0; }

		.nav-btn:hover {
			color: #fff;
			border-color: #000;
		}

		.nav-btn:hover svg,
		.nav-btn:hover svg path { stroke: #fff !important; }

		.nav-btn:disabled {
			opacity: 0.35;
			cursor: not-allowed;
		}

		.nav-btn:disabled::before { left: -100%; }

		.nav-btn:disabled:hover,
		.nav-btn[disabled]:hover {
			color: #0f2e3c;
			border-color: #e5e5e5;
		}

		.nav-btn:disabled svg path,
		.nav-btn[disabled] svg path,
		.nav-btn:disabled:hover svg path,
		.nav-btn[disabled]:hover svg path { stroke: currentColor !important; }

		/* ════════════════════════════════════════════════════════
		RESPONSIVE — All media query breakpoints
		════════════════════════════════════════════════════════ */

		/* ── XL ≥1400px ───────────────────────────────────────── */
		@media (min-width: 1400px) {
			.social-container { padding: 0 60px; }
			.section-title { font-size: 34px; }

			/* Show 4.5 cards — 5th card peeks on right like original */
			.social-card {
				flex: 0 0 calc((100% - (16px * 4)) / 4.5);
				width: calc((100% - (16px * 4)) / 4.5);
			}
		}

		/* ── LG 1200–1399px ────────────────────────────────── */
		@media (max-width: 1399px) and (min-width: 1200px) {
			/* Show 4.5 cards — 5th card peeks on right like original */
			.social-card {
				flex: 0 0 calc((100% - (16px * 4)) / 4.5);
				width: calc((100% - (16px * 4)) / 4.5);
			}
		}

		/* ── MD 992–1199px ─────────────────────────────────────── */
		@media (max-width: 1199px) and (min-width: 992px) {
			.social-section { padding: 40px 0 44px; }
			.social-container { padding: 0 28px; }
			.section-title { font-size: 28px; }

			/* Show 3.5 cards on medium desktop */
			.social-card {
				flex: 0 0 calc((100% - (16px * 3)) / 3.5);
				width: calc((100% - (16px * 3)) / 3.5);
			}

			.card-media-wrap { padding-bottom: 148%; }
		}

		/* ── SM 768–991px (Tablet portrait) ───────────────────── */
		@media (max-width: 991px) and (min-width: 768px) {
			.social-section { padding: 32px 0 36px; }
			.social-container { padding: 0 24px; }
			.section-title { font-size: 26px; }

			.social-card {
				flex: 0 0 185px;
				width: 185px;
			}

			.card-media-wrap { padding-bottom: 138%; }

			/* ── No hover on tablet ── */
			.product-name::after { display: none !important; }
			.play-btn:hover {
				background: rgba(0,0,0,0.38);
				transform: translate(-50%, -50%) scale(1);
			}
		}

		/* ── XS 576–767px (Mobile landscape) ──────────────────── */
		@media (max-width: 767px) and (min-width: 576px) {
			.social-section {
				padding: 24px 0 28px;
				overflow-x: hidden;
			}

			.social-container { padding: 0 16px; }

			.section-title { font-size: 22px; }

			.section-header { margin-bottom: 20px; }

			.social-card {
				flex: 0 0 170px;
				width: 170px;
			}

			.card-media-wrap { padding-bottom: 135%; }

			.user-name { font-size: 12px; }
			.user-handle { font-size: 10px; }

			/* ── No hover on mobile ── */
			.product-name::after { display: none !important; }
			.card-footer-info:hover .product-name::after { transform: none; }
			.play-btn:hover {
				background: rgba(0,0,0,0.38);
				transform: translate(-50%, -50%) scale(1);
			}
		}

		/* ── XXS ≤575px (Mobile portrait) ─────────────────────── */
		@media (max-width: 575px) {
			.social-section {
				padding: 20px 0 24px;
				overflow-x: hidden;
			}

			.social-container { padding: 0 14px; }

			.section-title { font-size: 20px; }

			.section-header { margin-bottom: 16px; }

			.social-card {
				flex: 0 0 160px;
				width: 160px;
			}

			.card-media-wrap { padding-bottom: 132%; }

			.card-user-header { padding: 10px 12px 8px; }
			.user-avatar { width: 30px; height: 30px; min-width: 30px; font-size: 12px; }
			.user-name { font-size: 12px; }
			.user-handle { font-size: 10px; }

			.card-footer-info { padding: 9px 12px 11px; }
			.product-name { font-size: 11.5px; }

			.slider-footer { margin-top: 20px; gap: 14px; }

			.nav-btn { width: 36px; height: 36px; }

			/* ── No hover on mobile ── */
			.product-name::after { display: none !important; }
			.card-footer-info:hover .product-name::after { transform: none; }
			.play-btn:hover {
				background: rgba(0,0,0,0.38);
				transform: translate(-50%, -50%) scale(1);
			}
		}

		/* ── Touch devices: disable all hover effects (cleanest method) ── */
		@media (hover: none) {
			.product-name::after { display: none !important; }
			.card-footer-info:hover .product-name::after { transform: none !important; }

			.play-btn:hover {
				background: rgba(0,0,0,0.38) !important;
				transform: translate(-50%, -50%) scale(1) !important;
			}

			.play-btn.playing { opacity: 1 !important; pointer-events: auto !important; }

			.nav-btn:hover::before { left: -100% !important; }
			.nav-btn:hover { color: #0f2e3c !important; border-color: #e5e5e5 !important; }
			.nav-btn:hover svg path { stroke: currentColor !important; }
		}

	}

	$_section { {{= &custom_css}} }
</style>

<section class="social-section" id="social-section" aria-label="What Trending On Social">
