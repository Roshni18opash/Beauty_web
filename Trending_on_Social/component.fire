<article class="social-card" id="social-card-1">
	<!-- User Header -->
	<div class="card-user-header">
		<div class="user-avatar" aria-hidden="true">
			{{$avatar_url = &creator_img != '' ? &creator_img : (&creator_image != '' ? &creator_image : '')}}
			{{= $avatar_url == '' ? substr(&creator_name, 0, 1) : '<img src="https://cdn.flicksell.com/'.$avatar_url.'" class="avatar-img" alt="'.&creator_name.'" />' }}
		</div>
		<div class="user-info">
			<span class="user-name">{{= &creator_name}}</span>
			<span class="user-handle">{{= &username}}</span>
		</div>
		<div class="tiktok-icon" aria-label="TikTok">
			<svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
				<path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.34 6.34 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.77a4.85 4.85 0 0 1-1.01-.08z"/>
			</svg>
		</div>
	</div>

	<!-- Video / Media -->
	<div class="card-media-wrap">
		<video
		class="card-video"
		src="{{= &pro_video == '' ? 'https://cdn.flicksell.cloud/preview/dummy_video.mp4' : 'https://cdn.flicksell.com/' .&pro_video}}"
		loop
		muted
		autoplay
		playsinline
		preload="metadata"
		poster="Images/img1.webp"
		aria-label="Stephanie's trending video - Facial Serum">
	</video>

	

	<!-- Play/Pause Button overlay -->
	<button class="play-btn" aria-label="Play video" data-state="paused">
		<svg class="icon-play" viewBox="0 0 24 24" fill="white" width="28" height="28">
			<path d="M8 5v14l11-7z"/>
		</svg>
		<svg class="icon-pause" viewBox="0 0 24 24" fill="white" width="28" height="28" style="display:none;">
			<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
		</svg>
	</button>
</div>

<!-- Card Footer -->
{{$product_item=system.product.get_product(&product)}}
{{$variant=system.product.get_lowest_priced_variant(&product)}}
{{$price=$variant["price"]}}
{{$mrp=$variant["mrp"]}}
<div class="card-footer-info">
	<div class="product-label">
		<img class="product-image" src="https://cdn.flicksell.com/{{= $product_item['main_img']}}" alt="{{= $product_item['name']}}" />
		<span class="product-name">{{= $product_item['name']}}</span>
	</div>
	<a href="#" class="product-arrow" aria-label="View {{= $product_item['name']}}">&#8250;</a>
</div>
</article>