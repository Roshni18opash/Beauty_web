<div class="category-card">
	<div class="category-img-wrapper">
		<img src="{{= &collectionimg == '' ? 'https://placehold.co/1920x630' : 'https://cdn.flicksell.com/'.&collectionimg}}" alt="Sale Product" class="category-img">
	</div>

		{{if &prod_title == 'y'}}
    <span class="category-text">{{= &pro_name}}</span>
{{endif}}
	

</div>