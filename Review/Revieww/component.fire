<div class="col-12 col-md-6 col-lg-4 d-flex review-card-wrapper">
	<article class="review-card w-100">
		<div>
			<div class="card-header-block">
				<img class="reviewer-avatar" src="{{= &cus_img == '' ? 'https://placehold.co/156x233' : 'https://cdn.flicksell.com/'.&cus_img}}" alt="Reviewer Photo" loading="lazy">

				<div class="reviewer-info">
					<h2 class="reviewer-name">{{= &reviewer_name}}</h2>
					<span class="reviewer-status">
						<svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" style="color: #198754;">
							<path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
						</svg>
						Verified Buyer
					</span>
				</div>
			</div>
			<p class="review-text">{{= &review_text}}</p>
		</div>
		<div>
			{{$product_item=system.product.get_product(&product)}}
			{{$variant=system.product.get_lowest_priced_variant(&product)}}
			{{$price=$variant["price"]}}
			{{$mrp=$variant["mrp"]}}
			<div class="card-product-divider"></div>
			<a href="#" class="product-link" aria-label="View product: Balancing Hypotonic">
				<img class="product-icon-img" src="https://cdn.flicksell.com/{{= $product_item['main_img']}}" alt="{{= $product_item['name']}}">
				<span class="product-name">{{= $product_item['name']}}</span>
			</a>
		</div>
	</article>
</div>